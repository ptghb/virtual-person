# OpenAI API 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ASR 语音识别配置（独立于 OPENAI_BASE_URL）
ASR_API_KEY=
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra

# 兼容旧配置：未配置 ASR_* 时会回退到 SILICONFLOW_*
SILICONFLOW_API_KEY=
SILICONFLOW_ASR_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra

# 智谱AI GLM-4V API配置
ZHIPUAI_API_KEY=

# 模型类型配置: zhipu 或 openai
MODEL_TYPE=zhipu

TTS_API_URL=http://localhost:3000
ISAUDIO=True
AUDIO_URL=http://localhost:3000
