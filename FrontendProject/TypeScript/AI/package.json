{
  "name": "xiaofan-ai-desktop",
  "version": "0.1.0",
  "description": "小凡 AI Live2D 桌面虚拟伴侣",
  "author": "小凡 AI",
  "private": true,
  "scripts": {
    "start": "node copy_resources.js && vite --host",
    "dev": "node copy_resources.js && vite --host",
    "desktop:dev": "concurrently -k \"vite --host --port 8091 --strictPort\" \"wait-on http://127.0.0.1:8091 && electron electron/main.cjs --dev\"",
    "build": "tsc --noEmit && node copy_resources.js && vite build --mode development",
    "build:prod": "node copy_resources.js && vite build",
    "build:desktop": "tsc --noEmit && node copy_resources.js && vite build --mode desktop",
    "desktop:build": "npm run build:desktop && electron-builder",
    "desktop:start": "npm run build:prod && electron electron/main.cjs",
    "copy_resources": "node copy_resources.js",
    "test": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "serve": "vite preview --port 8080 --host",
    "clean": "rimraf dist",
    "test:emotion": "vitest run src/__tests__/emotion.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "antd": "^6.2.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.5.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7",
    "concurrently": "^9.2.4",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.5"
  },
  "optionalDependencies": {
    "fsevents": "*"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@mediapipe/hands": "^0.4.1675469240",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "antd": "^6.2.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.laogeworld.xiaofan",
    "productName": "小凡AI",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/Resources",
        "to": "Resources"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.lifestyle"
    }
  }
}
